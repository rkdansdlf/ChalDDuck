# 이 파일(.env)은 운영(배포본)과 같은 Supabase 를 가리킵니다.
# 로컬 개발은 `.env.development.local` 로 DATABASE_URL·DIRECT_URL 을 로컬 Postgres 로
# 덮어쓰세요 — README 의 "로컬 DB 로 개발하기" 참고.
# 아래 두 주소는 Supabase 대시보드 > 프로젝트 > Connect 에서 그대로 복사합니다.
# 비밀번호는 거기서 다시 볼 수 없으니, 기억이 안 나면 Database > Settings 에서 재설정하세요.

# 앱 런타임용 — Transaction pooler (포트 6543).
# 서버리스에서 인스턴스가 계속 새로 떠도 Postgres 연결 수가 바닥나지 않습니다.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres"

# 마이그레이션(CLI)용 — Session pooler (포트 5432).
# 풀러(6543)로는 prepared statement 와 DDL 잠금을 못 버텨 마이그레이션이 중간에 깨집니다.
# IPv6 가 되는 환경이면 직결(db.PROJECT_REF.supabase.co:5432)을 써도 됩니다.
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

# AI 도구 5종(쿠션 번역기·AI 서기·리서처·발표 지원·문장 변환)이 쓰는 키입니다.
# openrouter.ai > Keys 에서 발급합니다.
# 비워 두면 앱은 그대로 돌아가고, 도구는 미리 적어 둔 샘플 결과를 돌려줍니다 —
# 화면이 "아직 AI가 연결되지 않았습니다"라고 그대로 알립니다.
OPENROUTER_KEY="sk-or-v1-..."

# 쓸 모델. 비워 두면 anthropic/claude-sonnet-5 를 씁니다.
# 슬러그 목록은 openrouter.ai/models 에 있습니다.
# OPENROUTER_MODEL="anthropic/claude-sonnet-5"

# 회의 응답 마감을 재는 예약 작업(`/api/cron/meetings`)이 확인하는 값입니다.
# 아무 문자열이나 길게 넣으면 됩니다 — 예: openssl rand -hex 32
# 비어 있으면 그 주소는 항상 401 을 돌려줍니다(설정을 깜빡한 배포에서
# 아무나 부를 수 있는 주소가 열리는 것보다 낫습니다).
# Vercel 에 올리면 Cron 이 이 값을 Authorization 헤더로 붙여 줍니다.
CRON_SECRET="..."

# 파일 업로드(Supabase Storage)가 쓰는 값입니다.
# SUPABASE_URL 은 대시보드 > Project Settings > API 의 Project URL 입니다
# (DATABASE_URL 의 postgres.<REF> 에서 REF 를 따 https://<REF>.supabase.co 와 같습니다).
#
# 키는 대시보드 > Project Settings > API Keys 의 **Secret key** 입니다.
# (Publishable key 가 아닙니다 — 그쪽은 브라우저에 노출돼도 되는 키라 저장소를 못 씁니다.)
#
# ⚠️ 이 키는 저장소 전체를 열 수 있습니다. 서버에서만 쓰이고(`server/storage/`)
# 브라우저로 나가지 않습니다. 이 앱은 Supabase Auth 를 쓰지 않아 저장소 RLS 가 판단할
# 사용자가 없으므로, 접근 권한은 앱이 서버에서 직접 확인합니다.
#
# 버킷은 `npm run db:storage` 로 한 번 만들어 둡니다(비공개, 50MB 제한).
SUPABASE_URL="https://PROJECT_REF.supabase.co"
SUPABASE_SECRET_KEY="sb_secret_..."

# 예전에 발급한 service_role 키(`eyJ...`)를 쓰고 있다면 이 이름으로 넣어도 됩니다.
# Supabase 가 2026년 말에 폐기할 예정이라 새로 만든다면 위쪽을 쓰세요.
# SUPABASE_SERVICE_ROLE_KEY="eyJ..."

# ── 이메일 로그인(인증번호 · 매직 링크) ──────────────────────────
# 팀장 승인 없이도 이 브라우저가 그 이메일의 소유자임을 증명하는 통로입니다.
# `RESEND_API_KEY` 는 resend.com > API Keys 에서 받습니다.
#
# ⚠️ 비어 있거나 발송이 실패하면 **운영에서 인증번호를 화면에 돌려주지 않습니다.** 대신
# 발송 실패라고 말합니다 — 메일이 안 나갔는데 인증번호만 도착하는 상태는 로그인 우회입니다.
# 로컬 개발(`next dev`)에서만 서버 로그와 화면에 6자리가 보이므로, 메일 없이 흐름을
# 확인하려면 개발 서버에서만 해 주세요.
RESEND_API_KEY="re_..."

# 메일이 도착했을 때 누를 주소의 시작점. 매직 링크(`/join/verify?token=…`)가 여기 기준
# 만들어집니다. 비어 있으면 `http://localhost:3000` 이라 **운영에서 도착한 링크가
# 로컬을 가리킵니다** — 로그인이 불가능해집니다.
NEXT_PUBLIC_APP_URL="https://your-app.vercel.app"

# ── 휴대폰 푸시 알림 ───────────────────────────────────────────
# 앱을 닫아 둔 사이에도 알림이 닿는 통로입니다(알림함 화면의 "알림 받기").
#
# 이 키 쌍은 **한 벌만** 씁니다 — 브라우저가 이 공개키로 구독하고, 서버가 개인키로 서명해
# 발신합니다. 새로 만들 때:  npx web-push generate-vapid-keys
# (개인키를 여기서 새로 만들면 예전에 구독한 기기들이 전부 구독을 다시 해야 합니다.)
#
# VAPID_SUBJECT 는 발신자로 보이는 연락처입니다 — 풀리지 않으면 기기가 "알 수 없는 발신자"로
# 보여 조용히 버릴 수 있으므로, 아무 문자열이나 넣어서는 안 됩니다.
#
# 비워 두면 앱은 그대로 돌아갑니다. 알림함의 "알림 받기"가 **켜지지 않는다고 그대로
# 말합니다**(AI 키와 같은 처리) — 켜진 척 하면서 아무것도 안 오는 상태를 만들지 않습니다.
NEXT_PUBLIC_VAPID_PUBLIC_KEY="..."
VAPID_PRIVATE_KEY="..."
VAPID_SUBJECT="mailto:team@chalddeok.app"
