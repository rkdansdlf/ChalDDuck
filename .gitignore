# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# 예시 파일에는 자리만 있고 비밀이 없다. README 가 이 파일을 보라고 하므로 저장소에 둔다.
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# prisma
/src/generated/prisma

# Working scratch
#
# Throwaway scripts for manual investigation. These get written often during debugging and
# easily get forgotten, and a leftover `scripts/tmp-*.mts` has real costs beyond just being
# ugly — `tsconfig.json` includes `**/*.mts`, so a scratch file half-finished gets pulled
# into `tsc --noEmit` and type errors, and worse, it lands in the commit history.
#
# Real check scripts are named after what they check (e.g. `check-schema-in-sync.mjs`,
# `smoke.mts`) and are not matched here.
scripts/tmp-*
scripts/*.tmp.*
.tmp-*
*_backup/

