// 찰떡 데이터 모델
//
// 데이터베이스는 Supabase Postgres 한 벌입니다 — 로컬 개발도 같은 곳을 씁니다.
// 환경마다 provider 가 달라지면 배포 때 스키마가 깨지기 때문입니다.
//
// 상태값(`status`, `kind` 등)은 아직 String 입니다. 어휘가 화면 쪽 `STATUS` 한 곳에
// 모여 있어서, Postgres enum 으로 조이려면 양쪽을 같이 옮겨야 합니다 — 지금은 미룹니다.

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

// Prisma 7 부터 연결 주소는 스키마가 아니라 `prisma.config.ts` 에 둔다.
datasource db {
  provider = "postgresql"
}

/// 팀. 초대 코드로만 들어온다 — 가입·로그인이 없다.
model Team {
  id        String   @id @default(cuid())
  name      String
  course    String
  /// 초대 코드. 이 코드를 아는 사람만 들어올 수 있다.
  code      String   @unique
  /// "중간발표 D-12" 같은 표시 문자열. 날짜 계산은 아직 기획에 없다.
  dday      String?
  /// 회의 후보(`MeetingSlot`)를 어느 주의 시간표로 만들었는지. 주가 바뀌면 다시 만든다 —
  /// "이 주만" 안 되는 시간이 다음 주 후보까지 막지 않게.
  candidatesWeek String?
  createdAt DateTime @default(now())

  members        Member[]
  joinRequests   JoinRequest[]
  submissionBoxes SubmissionBox[]
  meetingSlots   MeetingSlot[]
  proposals      MeetingProposal[]
  messages       Message[]
  tasks          Task[]
  aiUsage        AiUsage[]
  iceRounds      IceRound[]
}

/// 팀원. 신원은 **초대 코드 + 이름**이라 팀 안에서 이름이 유일해야 한다.
model Member {
  id           String   @id @default(cuid())
  teamId       String
  name         String
  /// 16유형 중 하나. 고르지 않고 넘어갈 수 있다.
  mbti         String?
  /// 30초 컷으로 얻은 값인지. 화면 문구가 달라진다.
  mbtiFromQuiz Boolean  @default(false)
  /// 팀을 만든 사람. 새 기기 재입장 요청을 승인한다. 팀마다 한 명이다.
  isLeader     Boolean  @default(false)
  /// 재입장 코드의 해시. 첫 입장 때 한 번만 보여 주고 여기에는 해시만 남는다.
  rejoinCodeHash String?
  /// 1순위 희망 역할 / 이번엔 피하고 싶은 역할.
  wantRole     String?
  vetoRole     String?
  joinedAt     DateTime @default(now())
  /// 팀을 나간 시각. 행은 **지우지 않는다** — 기여 기록·메시지·파일 이력이 성적 근거라
  /// 사람이 나갔다고 팀 기록이 사라지면 안 된다. 명단·집계에서만 빠진다.
  leftAt       DateTime?

  team            Team              @relation(fields: [teamId], references: [id], onDelete: Cascade)
  sessions        Session[]
  claims          MemberClaim[]     @relation("ClaimMember")
  approvedClaims  MemberClaim[]     @relation("ClaimApprover")
  approvedJoins   JoinRequest[]     @relation("JoinApprover")
  busyBlocks      BusyBlock[]
  ownedBoxes      SubmissionBox[]
  fileVersions    FileVersion[]
  messages        Message[]
  reactions       MessageReaction[]
  readMarks       ReadMark[]
  contribRecords  ContribRecord[]   @relation("ContribOwner")
  contribDisputes ContribRecord[]   @relation("ContribDisputer")
  contribConfirms ContribConfirm[]
  assignedTasks   Task[]
  pokesSent       Poke[]
  notifications   Notification[]    @relation("NotifyTo")
  notificationsBy Notification[]    @relation("NotifyBy")
  proposalsMade   MeetingProposal[]
  meetingResponses MeetingResponse[]
  roleDraws       RoleDraw[]
  roleRejections  RoleRejection[]
  aiUsage         AiUsage[]
  iceHosted       IceRound[]        @relation("IceHost")
  iceSeats        IceSeat[]         @relation("IceSeatOf")

  @@unique([teamId, name])
}

/// 브라우저 하나 = 기기 하나. 쿠키에는 `token` 만 담고 회원 식별자는 담지 않는다.
model Session {
  token      String   @id
  memberId   String
  createdAt  DateTime @default(now())
  /// 마지막으로 쓰인 시각. 기기 목록에 보이고, 매 요청마다 쓰지는 않는다.
  lastSeenAt DateTime @default(now())
  /// 지나면 더 이상 통하지 않는다. 쿠키 만료만 믿으면 쿠키 값을 얻은 쪽이 영원히 쓴다.
  expiresAt  DateTime
  /// 기기를 알아볼 수 있는 짧은 설명("iPhone · Safari").
  label      String?

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId])
}

/// 이미 있는 이름으로 **새 기기에서** 들어오려는 요청. 팀장이 승인해야 통과한다.
///
/// 이름만으로 통과시키면 초대 코드를 아는 사람이 팀원을 사칭할 수 있다.
/// 재입장 코드를 가진 사람은 이 표를 거치지 않고 바로 들어온다.
model MemberClaim {
  id           String    @id @default(cuid())
  memberId     String
  /// 승인되면 이 토큰으로 세션이 만들어진다. 요청한 브라우저만 갖고 있다.
  token        String    @unique
  /// pending | approved | rejected
  status       String    @default("pending")
  label        String?
  createdAt    DateTime  @default(now())
  resolvedAt   DateTime?
  approvedById String?

  member     Member  @relation("ClaimMember", fields: [memberId], references: [id], onDelete: Cascade)
  approvedBy Member? @relation("ClaimApprover", fields: [approvedById], references: [id], onDelete: SetNull)

  @@index([memberId])
}

/// 재입장 코드를 틀린 횟수.
///
/// **표에 둔다.** 예전에는 프로세스 메모리의 `Map` 이었는데, 서버리스는 요청마다 다른
/// 인스턴스가 받을 수 있어서 인스턴스 수만큼 시도가 늘어났다 — 5번 제한이 사실상 없는
/// 것과 같았다. 세는 곳이 한 군데여야 제한이 제한이다.
///
/// 키는 `<초대 코드>:<이름>` 을 정규화한 값의 해시다. 해시로 두는 이유는 길이를 묶고
/// 이 표만 보고 팀원 이름을 훑지 못하게 하기 위해서다.
model RejoinAttempt {
  key   String   @id
  count Int      @default(1)
  /// 이 시각이 지나면 횟수를 처음부터 다시 센다(= 잠금이 풀린다).
  until DateTime
}

/// 팀에 **처음** 들어오려는 요청. 팀장이 승인해야 팀원이 된다.
///
/// 초대 코드를 아는 것만으로 들어오면, 코드가 한 번 새면 누구든 팀 안을 볼 수 있다.
/// 팀장이 직접 초대했든 본인이 요청했든 마지막 문은 팀장이 연다.
///
/// 아직 `Member` 가 아니라서 온보딩에서 고른 값(MBTI·희망 역할)을 여기 들고 있다가,
/// 승인되는 순간 `Member` 로 옮긴다.
model JoinRequest {
  id           String    @id @default(cuid())
  teamId       String
  name         String
  mbti         String?
  mbtiFromQuiz Boolean   @default(false)
  wantRole     String?
  vetoRole     String?
  /// 승인되면 이 토큰으로 세션이 만들어진다. 요청한 브라우저만 갖고 있다.
  token        String    @unique
  /// pending | approved | rejected
  status       String    @default("pending")
  label        String?
  createdAt    DateTime  @default(now())
  resolvedAt   DateTime?
  approvedById String?

  team       Team    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  approvedBy Member? @relation("JoinApprover", fields: [approvedById], references: [id], onDelete: SetNull)

  /// 같은 이름으로 요청이 쌓이지 않게 한다.
  @@unique([teamId, name])
  @@index([teamId])
}

/// 앱 안 알림.
///
/// 팀플에서 놓치는 일은 대부분 "나한테 온 줄 몰랐다"에서 온다. 콕 찌르기·회의 제안·
/// 정정 요청은 전부 "알린다"고 적혀 있지만, 앱을 열어 그 화면까지 가야만 보였다.
///
/// **보낸 사람을 남긴다.** 누가 요청했는지 알아야 답할 수 있다.
model Notification {
  id        String    @id @default(cuid())
  /// 받는 사람.
  memberId  String
  /// poke | meeting | schedule-ask | contrib-dispute | contrib-confirm | join-request | rejoin-request
  kind      String
  title     String
  body      String
  /// 누르면 갈 곳. 없으면 알림만 보여 준다.
  href      String?
  /// 보낸 사람. 시스템이 보낸 것이면 null.
  actorId   String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  member Member  @relation("NotifyTo", fields: [memberId], references: [id], onDelete: Cascade)
  actor  Member? @relation("NotifyBy", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([memberId, readAt])
}

/// 안 되는 시간 한 칸. 표시하지 않은 시간은 가능한 시간으로 본다.
model BusyBlock {
  id        String @id @default(cuid())
  memberId  String
  /// 0 = 월요일.
  day       Int
  /// `SCHEDULE_HOURS` 의 인덱스.
  startHour Int
  hours     Int
  /// class | work | exam | custom — 사유는 본인에게만 보인다.
  kind      String
  /// `custom` 일 때 본인이 적은 이름("동아리"). 팀원에게는 어디서도 보이지 않는다.
  label     String?
  /// null = 매주. 값이 있으면 그 주에만 — 그 주 월요일의 한국 날짜("2026-09-28").
  /// 시각이 아니라 날짜 문자열이라 서버·화면의 시간대와 상관없이 같은 주를 가리킨다.
  weekOf    String?

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId])
}

/// 회의 시간 후보.
///
/// TODO: 지금은 미리 넣어 둔 값이다. 원래는 팀원들의 `BusyBlock` 에서 계산해야 한다 —
/// 계산 규칙(주말 포함 여부, 최소 길이)이 기획에 확정되면 그때 옮긴다.
model MeetingSlot {
  id         String @id @default(cuid())
  teamId     String
  /// "수" 같은 요일 한 글자.
  day        String
  /// "16:00 – 18:00"
  time       String
  available  Int
  total      Int
  /// 못 오는 사람과 사유. 전원 가능하면 null.
  blockedBy  String?
  /// 어느 주의 후보인지. "this" = 이번 주, "none" = 전원 불가한 주(데모).
  weekKey    String @default("this")

  team      Team              @relation(fields: [teamId], references: [id], onDelete: Cascade)
  proposals MeetingProposal[]

  @@index([teamId, weekKey])
}

/// 회의 제안. **특정 한 사람이 단독으로 확정하지 않는다** — 마감까지 반대가 없어야 확정된다.
model MeetingProposal {
  id           String   @id @default(cuid())
  teamId       String
  slotId       String?
  proposedById String
  /// proposed | confirmed | carried — idle 은 행이 없는 상태다.
  stage        String   @default("proposed")
  /// 응답 마감 시각. 이때까지 반대가 없으면 확정.
  respondBy    DateTime
  createdAt    DateTime @default(now())

  team       Team              @relation(fields: [teamId], references: [id], onDelete: Cascade)
  slot       MeetingSlot?      @relation(fields: [slotId], references: [id], onDelete: SetNull)
  proposedBy Member            @relation(fields: [proposedById], references: [id], onDelete: Cascade)
  responses  MeetingResponse[]

  @@index([teamId])
}

model MeetingResponse {
  id         String   @id @default(cuid())
  proposalId String
  memberId   String
  /// true = 동의, false = 참석 어려움.
  agree      Boolean
  createdAt  DateTime @default(now())

  proposal MeetingProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  member   Member          @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([proposalId, memberId])
}

/// 역할 추첨 결과. 당사자가 수락해야 확정된다.
model RoleDraw {
  id        String   @id @default(cuid())
  teamId    String
  /// research | deck | script | present | manage
  role      String
  /// 어떤 도구로 뽑았는지 — "룰렛" 처럼 화면에 그대로 보인다.
  tool      String
  winnerId  String
  accepted  Boolean  @default(false)
  createdAt DateTime @default(now())

  winner Member @relation(fields: [winnerId], references: [id], onDelete: Cascade)

  @@unique([teamId, role])
}

/// 추첨을 거절해 다음 추첨에서 빠지는 사람.
model RoleRejection {
  id       String @id @default(cuid())
  teamId   String
  role     String
  memberId String

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([teamId, role, memberId])
}

/// 역할별 제출함. 마감이 지나도 잠그지 않고 라벨만 붙인다.
model SubmissionBox {
  id       String @id @default(cuid())
  teamId   String
  role     String
  name     String
  /// 이 칸을 맡은 사람. **역할이 정해지기 전에는 비어 있다** — 팀을 만들면 제출함부터
  /// 생기고, 역할 추첨을 수락하면 그 사람이 주인이 된다.
  ownerId  String?
  /// 마감 시각. **"마감 후 제출" 라벨은 이 값과 버전의 `createdAt` 으로 그때그때 계산한다** —
  /// 마감을 옮기면 라벨도 따라 바뀐다. 정하지 않았으면 null 이고 라벨이 붙지 않는다.
  dueAt    DateTime?
  /// 예전 표시 문자열("9/15", "미정"). `dueAt` 이 없을 때만 화면에 보인다.
  due      String

  team  Team            @relation(fields: [teamId], references: [id], onDelete: Cascade)
  owner Member?         @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  files SubmittedFile[]

  @@index([teamId])
}

/// 제출함에 올라온 파일 하나.
///
/// 제출함과 버전 사이에 이 단계가 필요하다 — 한 제출함에 파일이 여러 개일 수 있고
/// (발표자료.pptx 와 대본.docx), 버전은 **그 파일 하나**의 역사이기 때문이다.
model SubmittedFile {
  id        String   @id @default(cuid())
  boxId     String
  /// 화면에 보이는 파일 이름("발표 자료.pptx").
  name      String
  /// pptx | docx | pdf | image
  kind      String
  createdAt DateTime @default(now())

  box      SubmissionBox @relation(fields: [boxId], references: [id], onDelete: Cascade)
  versions FileVersion[]

  @@index([boxId])
}

/// 파일 버전. **덮어쓰지 않고 쌓인다** — 복원도 새 버전을 더하는 것이다.
model FileVersion {
  id         String   @id @default(cuid())
  fileId     String
  /// "v4" 처럼 화면에 그대로 보이는 이름.
  label      String
  authorId   String
  note       String
  size       String
  /// pptx | docx | pdf | image
  kind       String
  /// 실제로 열리는 형식만 미리보기 주소를 갖는다. 저장소에 올린 파일은 볼 때마다
  /// 서명된 주소를 새로 만들므로 여기에는 남기지 않는다(시드 이미지에만 남아 있다).
  previewUrl String?
  /// Supabase Storage 안의 경로. 저장소에 없는 시드 데이터는 null 이다.
  storagePath String?
  /// 실제 바이트 수. `size` 는 화면에 보이는 문자열이라 계산에 쓰면 안 된다.
  bytes      Int?
  /// 내려받을 때 브라우저에 알려 줄 형식.
  mimeType   String?
  /// 쓰지 않는다 — 올릴 때 한 번 적어 두면 마감을 옮겨도 라벨이 안 바뀌었다.
  /// 이제 `SubmissionBox.dueAt` 과 `createdAt` 으로 계산한다. 다음 정리 때 지운다.
  isLate     Boolean  @default(false)
  createdAt  DateTime @default(now())
  /// 쓰지 않는다 — 저장된 "방금"이 영원히 "방금"으로 보였다. 화면 시각은 `createdAt` 으로
  /// 서버가 만든다. 다음 정리 때 지운다.
  whenLabel  String?
  /// 복원으로 생긴 버전이면 원본 버전 id. 복원은 마감과 무관한 작업이라 늦은 제출로 세지
  /// 않고, 같은 저장소 객체를 가리키므로 용량에도 두 번 세지 않는다.
  restoredFromId String?

  file   SubmittedFile @relation(fields: [fileId], references: [id], onDelete: Cascade)
  author Member        @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([fileId])
}

/// 메시지. 팀 단톡방과 1:1 DM 이 같은 표에 들어가고 `threadKey` 로 갈린다.
model Message {
  id         String   @id @default(cuid())
  teamId     String
  /// "team" 또는 DM 상대 두 명의 id 를 정렬해 이은 값("dm:<a>:<b>").
  threadKey  String
  authorId   String
  text       String
  /// 쿠션 번역기로 다듬어 보낸 말. **표시가 남는다.**
  viaCushion Boolean  @default(false)
  /// 첨부 파일(단톡방만). 저장소 경로는 `{teamId}/chat/{uuid}` — 드라이브와 같은 버킷·형식·용량 규칙.
  /// 파일만 보낸 말은 `text` 가 빈 문자열이다.
  attachPath  String?
  attachName  String?
  attachBytes Int?
  attachMime  String?
  createdAt  DateTime @default(now())
  /// 화면에 보이는 시각 문자열("14:02").
  whenLabel  String

  team      Team              @relation(fields: [teamId], references: [id], onDelete: Cascade)
  author    Member            @relation(fields: [authorId], references: [id], onDelete: Cascade)
  reactions MessageReaction[]

  @@index([teamId, threadKey])
}

model MessageReaction {
  id        String @id @default(cuid())
  messageId String
  memberId  String
  icon      String

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  member  Member  @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([messageId, memberId, icon])
}

/// 어디까지 읽었는지. 안 읽음 배지가 이 값으로 계산된다.
model ReadMark {
  id        String   @id @default(cuid())
  memberId  String
  threadKey String
  readAt    DateTime @default(now())

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([memberId, threadKey])
}

/// 기여 기록.
///
/// 내 화면(16)과 팀 화면(17)이 **같은 표**를 본다 — 두 표로 나누면 같은 일이 두 곳에서
/// 다르게 적히는 일이 생긴다.
model ContribRecord {
  id        String   @id @default(cuid())
  memberId  String
  /// task | file | meet | help | due
  kind      String
  title     String
  detail    String
  /// "9/8 – 9/12" 같은 표시 문자열.
  whenLabel String
  /// auto = 앱이 모음 / self = 본인이 직접 추가
  source    String
  /// ok | pending | disputed — 확인 수와 의견에서 다시 계산한다(`server/contrib/state.ts`).
  state     String   @default("pending")
  /// 사실과 다르다고 적힌 의견. **한쪽 말로 덮지 않고 남긴다.**
  dispute   String?
  /// 그 의견을 적은 사람. 다툼이 생기면 누가 적었는지가 중요하다.
  disputedById String?
  /// 정정에 어떻게 답했는지("공동 작업으로 나눔"). 적히면 의견 차이가 정리된 것으로 본다.
  /// `dispute` 는 여기 값이 생겨도 지우지 않는다 — 지우면 한쪽 말로 덮는 것이 된다.
  resolution String?
  /// 근거 파일. 본인이 직접 추가한 기록에만 붙는다 — 팀원이 확인할 때 열어 본다.
  /// 저장소 경로는 `{teamId}/evidence/{uuid}` 이고 드라이브와 같은 버킷·형식·용량 규칙을 따른다.
  evidencePath  String?
  evidenceName  String?
  evidenceBytes Int?
  evidenceMime  String?
  createdAt DateTime @default(now())

  member     Member          @relation("ContribOwner", fields: [memberId], references: [id], onDelete: Cascade)
  disputedBy Member?         @relation("ContribDisputer", fields: [disputedById], references: [id], onDelete: SetNull)
  confirms   ContribConfirm[]

  @@index([memberId])
}

/// 기여 기록 하나에 대한 팀원의 확인.
///
/// 본인이 넣은 기록은 팀원이 확인해야 확정된다 — 본인 말만으로 확정되면 기록이
/// 근거가 되지 못한다. 누가 확인했는지 남아야 나중에 다툴 때 따져 볼 수 있다.
model ContribConfirm {
  id        String   @id @default(cuid())
  recordId  String
  memberId  String
  createdAt DateTime @default(now())

  record ContribRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)
  member Member        @relation(fields: [memberId], references: [id], onDelete: Cascade)

  /// 같은 사람이 같은 기록을 두 번 확인하지 못한다.
  @@unique([recordId, memberId])
  @@index([recordId])
}

/// 할 일. 팀 업무·개인 학습·점검이 한 목록에 있고 종류로만 구분된다.
model Task {
  id         String   @id @default(cuid())
  teamId     String
  title      String
  /// team | study | check
  kind       String
  /// 담당자. 정해지지 않았으면 null — 비워 두는 것이 임의 배정보다 낫다.
  assigneeId String?
  /// "9/19" 같은 표시 문자열.
  due        String
  /// todo | doing | done
  status     String   @default("todo")
  /// clerk = AI 서기가 만듦 / manual = 사람이 직접 넣음
  source     String   @default("manual")
  createdAt  DateTime @default(now())

  team     Team    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  assignee Member? @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  pokes    Poke[]

  @@index([teamId])
}

/// 콕 찌르기 — 담당자에게 **제출이나 진행상황을 요청**한다.
///
/// 보낸 사람을 밝힌다. 누가 물었는지 알아야 답할 수 있고, 익명 재촉은
/// 답할 곳 없는 압박이 된다. 대신 **업무당 하루 한 번**으로 횟수를 막는다.
model Poke {
  id       String   @id @default(cuid())
  taskId   String
  senderId String
  sentOn   String
  createdAt DateTime @default(now())

  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  sender Member @relation(fields: [senderId], references: [id], onDelete: Cascade)

  /// 같은 사람이 같은 업무를 같은 날 두 번 찌를 수 없다.
  @@unique([taskId, senderId, sentOn])
}

/// AI 도구를 한 번 쓴 기록.
///
/// **입력한 글도 결과도 남기지 않는다** — 남는 것은 "누가 언제 어떤 도구를 썼는지"뿐이다.
/// 호출마다 비용이 들어서 하루 한도를 세려면 어딘가에 세어 둘 곳이 필요하고,
/// 그 한도를 넘는 순간 화면이 그 사실을 그대로 알려 줘야 하기 때문이다.
///
/// 보관 기간은 `AI_POLICY.retentionDays` 다. 지난 행은 예약 작업이 지운다.
model AiUsage {
  id       String @id @default(cuid())
  teamId   String
  memberId String
  /// cushion | clerk | research | present | sentence
  tool     String
  /// 한국 날짜(YYYY-MM-DD). 콕 찌르기의 "하루"와 같은 기준이다 — 서버가 어디서 돌든
  /// 같은 하루여야 한다.
  day      String
  createdAt DateTime @default(now())

  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([teamId, day])
  @@index([memberId, day])
}

/// 28 아이스브레이킹의 한 판 — 라이어 게임·마피아.
///
/// 비밀(제시어·역할)은 **서버가 나누고 서버에만 있다.** 화면에는 각자 자기 카드만 내려간다 —
/// 폰에서 나누면 개발자 도구로 남의 카드를 볼 수 있다.
///
/// 팀마다 진행 중인 판은 하나다. `activeKey` 는 진행 중일 때만 `teamId` 를 담고 끝나면
/// 비운다 — 여기에 unique 가 걸려 있어 두 사람이 동시에 "시작"을 눌러도 판이 둘 생기지 않는다.
/// (Postgres 의 unique 는 NULL 을 여럿 허용하므로 끝난 판은 얼마든지 쌓인다.)
model IceRound {
  id        String    @id @default(cuid())
  teamId    String
  activeKey String?   @unique
  /// liar | mafia
  game      String
  /// play = 진행 중(투표 받는 중) / revealed = 결과 공개
  phase     String    @default("play")
  /// 라이어 게임의 주제와 제시어. 제시어는 결과 공개 전에는 라이어가 아닌 사람에게만 보인다.
  topic     String?
  word      String?
  /// 마피아의 결과 문구("시민 승리"). 끝나기 전에는 null.
  outcome   String?
  /// 판을 연 사람 = 사회자. 결과 공개·투표 마감·끝내기를 할 수 있다(팀장도 할 수 있다).
  hostId    String
  createdAt DateTime  @default(now())
  endedAt   DateTime?

  team  Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  host  Member    @relation("IceHost", fields: [hostId], references: [id], onDelete: Cascade)
  seats IceSeat[]

  @@index([teamId, createdAt])
}

/// 한 판의 자리. 시작할 때 있던 팀원만 앉는다 — 중간에 들어온 사람은 구경만 한다.
model IceSeat {
  roundId   String
  memberId  String
  /// 라이어: liar | citizen / 마피아: mafia | police | doctor | citizen
  role      String
  /// 마피아에서 탈락한 시각과 방법(vote = 낮 투표 / night = 사회자가 밤 결과로 표시).
  /// 라이어 게임은 늘 null. 탈락 순서는 `outAt` 으로 정한다.
  outAt     DateTime?
  outHow    String?
  /// 지금 투표에서 고른 사람. 투표를 마감하면 비운다.
  voteForId String?

  round  IceRound @relation(fields: [roundId], references: [id], onDelete: Cascade)
  member Member   @relation("IceSeatOf", fields: [memberId], references: [id], onDelete: Cascade)

  @@id([roundId, memberId])
}
