// 찰떡 데이터 모델
//
// 데이터베이스는 Supabase Postgres 한 벌입니다 — 로컬 개발도 같은 곳을 씁니다.
// 환경마다 provider 가 달라지면 배포 때 스키마가 깨지기 때문입니다.
//
// 상태값(`status`, `kind` 등)은 아직 String 입니다. 어휘가 화면 쪽 `STATUS` 한 곳에
// 모여 있어서, Postgres enum 으로 조이려면 양쪽을 같이 옮겨야 합니다 — 지금은 미룹니다.

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

// Prisma 7 부터 연결 주소는 스키마가 아니라 `prisma.config.ts` 에 둔다.
datasource db {
  provider = "postgresql"
}

/// 팀. 초대 코드로만 들어온다 — 가입·로그인이 없다.
model Team {
  id        String   @id @default(cuid())
  name      String
  course    String
  /// 초대 코드. 이 코드를 아는 사람만 들어올 수 있다.
  code      String   @unique
  /// "중간발표 D-12" 같은 표시 문자열. 날짜 계산은 아직 기획에 없다.
  dday      String?
  /// 회의 후보(`MeetingSlot`)를 어느 날부터 7일로 만들었는지(한국 날짜). 날이 바뀌면 다시
  /// 만든다 — 지난 날이 후보에 남거나, 지난주에만 있던 시간이 후보를 막지 않게.
  candidatesFrom String?
  /// 29 누가 하지로 정한 밥. **팀에 하나** — 각자 돌리면 네 사람이 네 값을 보고
  /// 무엇을 먹을지 합의가 되지 않는다(예전에는 폰마다 따로 돌았다).
  menuPick String?
  menuDrawnBy String?
  menuPickedAt DateTime?
  /// 29 누가 하지에서 **무엇으로** 정했는지 — `RANDOM_TOOLS` 의 이름("사다리타기" 등).
  ///
  /// 도구는 누가 눌렀는지만 고르지만, **결과와 짝으로 팀에 하나**여야 한다. 결과만 남기고
  /// 도구를 버리면 팀원마다 "저 건 무슨 것으로 뽑혔지"가 달라져, "정한 건 팀에 하나"라는
  /// 화면의 약속이 그 자리에서 어긋난다.
  menuTool String?
  /// 기록이 `ok` 되려면 몇 명이 확인해야 하는가 — **팀이 정하는 값**이다.
  ///
  /// 예전에는 코드 상수(`CONFIRMS_NEEDED = 1`)였다. 상수로 두면 기준을 정하는 사람이
  /// 코드를 고쳐 배포해야 했고, "몇 명이 확인해야 확정인지"가 미정인 상태가 화면 문구로만
  /// 남았다. 팀장이 이 화면에서 고른다.
  ///
  /// 1을 기본으로 두는 이유: 전원으로 두면 한 사람이 답하지 않을 때 영영 확정되지 않는다.
  /// 올릴 수 있는 최댓값은 팀원 수에서 자기 기록의 주인을 뺀 만큼이다(자기 기록은
  /// 확인하지 못한다) — 팀장이 화면 밖의 값을 넣지 못하게 서버가 막는다.
  confirmsNeeded Int      @default(1)
  createdAt DateTime @default(now())

  members        Member[]
  joinRequests   JoinRequest[]
  invites        TeamInvite[]
  submissionBoxes SubmissionBox[]
  meetingSlots   MeetingSlot[]
  proposals      MeetingProposal[]
  messages       Message[]
  tasks          Task[]
  aiUsage        AiUsage[]
  iceRounds      IceRound[]
}

/// 팀에 들어올 수 있는 **초대 한 장.** 공유 한 번을 독립된 행으로 세운다.
///
/// 예전에는 `Team.code` **하나**가 팀을 대표하는 공유 credential 이었다. 그래서 A 에게 보낸
/// 링크를 되돌리려면 팀 코드 전체를 바꿔야 했고(정상적으로 나간 모든 공유까지 죽는다),
/// expires·사용 횟수·폐기 자리가 아예 없었다. 초대를 행으로 승격하면 각각을 따로 되돌린다.
///
/// ## 왜 별도 객체여야 하는가
///
/// URL 을 누가 조립했는지가 문제가 아니라, **`CD-XXXXXX` 하나가 팀을 대표하는 장기 공유
/// credential 역할까지 한다는 것**이 문제다. 초대를 리소스로 만들면 그 뒤는 전부 자연스럽다 —
/// 1회용 링크, 만료 링크, 초대 취소, "누가 어떤 링크로 들어왔는지".
///
/// ## 아직 쓰지 않는 칸도 있다
///
/// - `shortCode` — 사람이 직접 옮겨 적을 코드. **오늘 직접 입력하는 길은 `Team.code` 다.**
///   팀을 만들 때 함께 받는 첫 초대에 이 값을 붙이지 *않는* 이유: `Team.code` 와 같은 값을
///   두 곳에 두면, 그 초대를 폐기해도 `Team.code` 로 그대로 들어올 수 있어 **폐기가 헛것**이
///   된다. 직접 입력 길을 이 값으로 옮기는 것은 `Team.code` 를 없애는 마이그레이션과 함께 한다.
///   열려 있는 이유는 그때 마이그레이션을 다시 안 만들기 위해서다.
model TeamInvite {
  id     String @id @default(cuid())
  teamId String

  /// 링크 토큰의 **해시.** 원문은 저장하지 않는다 — DB 가 새어 나가도 살아 있는 링크가 그대로
  /// 노출되지 않는다.
  ///
  /// sha256 으로 충분하다. `auth/rejoin-code.ts` 가 scrypt 를 쓰는 건 그 코드가 사람이 직접
  /// typing 하는 **저엔트로피** 값이라 추측 비용을 올려야 했기 때문이다. 여기는 256비트라
  /// 추측이 불가능하고, 느린 KDF 는 아무것도 사지 못한다.
  tokenHash String @unique

  /// 직접 옮겨 적을 짧은 코드. 전역 유일이다 — 팀을 모르는 사람이 치기 때문이다.
  shortCode String? @unique

  /// 팀장이 붙이는 이름. "발표 준비" 같은 것.
  ///
  /// 없으면 목록이 "3일 전 · 0/3명"처럼 읽혀서, 초대가 몇 개 쌓였을 때 **어느 것이 무엇인지
  /// 알 수 없다.** 되돌리려면 고를 수 있어야 하니 붙인다. 고유할 필요는 없다.
  label     String?

  /// 몇 명이 **승인**되면 닫히는가. null 이면 무제한.
  ///
  /// 1 이면 1회용이고, **별도 정책 enum 은 두지 않는다.** 지금은 모든 초대가
  /// "신청 → 팀장 승인" 한 가지 길뿐이라 정책 값이 하나뿐이다. 자동으로 들어오게 하는
  /// 날이 오면 그때 값을 더한다 — 지금 미리 넣으면 갱신해야 할 enum 이 생긴다.
  maxUses Int?

  /// 승인으로 열린 자리. **거절과 취소를 세지 않는다** — 거절된 사람은 아무 자리도 쓰지
  /// 않았으므로, 세면 "1회용" 초대가 실패 한 번으로 닫혀 버린다.
  useCount Int @default(0)

  expiresAt DateTime?
  /// 되돌린 시각. 삭제를 쓰지 않는다 — 이 행이 "누가 이 초대를 만들었나"의 기록이기 때문.
  revokedAt DateTime?
  createdAt DateTime @default(now())

  team         Team          @relation(fields: [teamId], references: [id], onDelete: Cascade)
  joinRequests JoinRequest[]

  @@index([teamId])
}

/// 팀원. 신원은 **초대 코드 + 이름**이라 팀 안에서 이름이 유일해야 한다.
model Member {
  id           String   @id @default(cuid())
  teamId       String
  name         String
  /// 16유형 중 하나. 고르지 않고 넘어갈 수 있다.
  mbti         String?
  /// 30초 컷으로 얻은 값인지. 화면 문구가 달라진다.
  mbtiFromQuiz Boolean  @default(false)
  /// 팀을 만든 사람. 새 기기 재입장 요청을 승인한다. 팀마다 한 명이다.
  isLeader     Boolean  @default(false)
  /// 재입장 코드의 해시. 첫 입장 때 한 번만 보여 주고 여기에는 해시만 남는다.
  rejoinCodeHash String?
  /// 로그인 및 재접속용 이메일
  email        String?
  emailVerifiedAt DateTime?
  /// 1순위 희망 역할 / 이번엔 피하고 싶은 역할.
  wantRole     String?
  vetoRole     String?
  joinedAt     DateTime @default(now())
  /// 팀을 나간 시각. 행은 **지우지 않는다** — 기여 기록·메시지·파일 이력이 성적 근거라
  /// 사람이 나갔다고 팀 기록이 사라지면 안 된다. 명단·집계에서만 빠진다.
  leftAt       DateTime?

  team            Team              @relation(fields: [teamId], references: [id], onDelete: Cascade)
  sessions        Session[]
  claims          MemberClaim[]     @relation("ClaimMember")
  approvedClaims  MemberClaim[]     @relation("ClaimApprover")
  approvedJoins   JoinRequest[]     @relation("JoinApprover")
  busyBlocks      BusyBlock[]
  ownedBoxes      SubmissionBox[]
  fileVersions    FileVersion[]
  messages        Message[]
  reactions       MessageReaction[]
  readMarks       ReadMark[]
  readCushions    ReadCushion[]
  contribRecords  ContribRecord[]   @relation("ContribOwner")
  contribDisputes ContribRecord[]   @relation("ContribDisputer")
  contribConfirms ContribConfirm[]
  /// 이 사람이 남긴 의견들(`ContribDispute`).
  disputesWritten ContribDispute[]   @relation("ContribDisputesBy")
  /// 이 사람이 찍은 참여 표시들(`ContribParticipation`).
  participationsShown ContribParticipation[] @relation("ParticipationShownBy")
  participationsCleared ContribParticipation[] @relation("ParticipationClearedBy")
  assignedTasks   Task[]
  /// 누가 넣었나 — 담당자 지정 권한의 근거(`server/actions/tasks.ts` 의 `canEditTask`).
  tasksCreated    Task[]      @relation("TaskCreator")
  pokesSent       Poke[]
  notifications   Notification[]    @relation("NotifyTo")
  notificationsBy Notification[]    @relation("NotifyBy")
  /// 이 브라우저(단말)의 푸시 구독들. 기기 하나가 여러 개일 수 있다(여러 탭·프로필).
  pushSubscriptions PushSubscription[]
  proposalsMade   MeetingProposal[]
  meetingResponses MeetingResponse[]
  roleDraws       RoleDraw[]
  roleRejections  RoleRejection[]
  aiUsage         AiUsage[]
  iceHosted       IceRound[]        @relation("IceHost")
  iceSeats        IceSeat[]         @relation("IceSeatOf")

  @@unique([teamId, name])
  @@index([email])
}

/// 브라우저 하나 = 기기 하나. 쿠키에는 `token` 만 담고 회원 식별자는 담지 않는다.
model Session {
  token      String   @id
  memberId   String
  createdAt  DateTime @default(now())
  /// 마지막으로 쓰인 시각. 기기 목록에 보이고, 매 요청마다 쓰지는 않는다.
  lastSeenAt DateTime @default(now())
  /// 지나면 더 이상 통하지 않는다. 쿠키 만료만 믿으면 쿠키 값을 얻은 쪽이 영원히 쓴다.
  expiresAt  DateTime
  /// 기기를 알아볼 수 있는 짧은 설명("iPhone · Safari").
  label      String?

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId])
}

/// 이미 있는 이름으로 **새 기기에서** 들어오려는 요청. 팀장이 승인해야 통과한다.
///
/// 이름만으로 통과시키면 초대 코드를 아는 사람이 팀원을 사칭할 수 있다.
/// 재입장 코드를 가진 사람은 이 표를 거치지 않고 바로 들어온다.
model MemberClaim {
  id           String    @id @default(cuid())
  memberId     String
  /// 승인되면 이 토큰으로 세션이 만들어진다. 요청한 브라우저만 갖고 있다.
  token        String    @unique
  /// pending | approved | rejected
  status       String    @default("pending")
  label        String?
  createdAt    DateTime  @default(now())
  resolvedAt   DateTime?
  approvedById String?

  member     Member  @relation("ClaimMember", fields: [memberId], references: [id], onDelete: Cascade)
  approvedBy Member? @relation("ClaimApprover", fields: [approvedById], references: [id], onDelete: SetNull)

  @@index([memberId])
}

/// 재입장 코드를 틀린 횟수.
///
/// **표에 둔다.** 예전에는 프로세스 메모리의 `Map` 이었는데, 서버리스는 요청마다 다른
/// 인스턴스가 받을 수 있어서 인스턴스 수만큼 시도가 늘어났다 — 5번 제한이 사실상 없는
/// 것과 같았다. 세는 곳이 한 군데여야 제한이 제한이다.
///
/// 키는 `<초대 코드>:<이름>` 을 정규화한 값의 해시다. 해시로 두는 이유는 길이를 묶고
/// 이 표만 보고 팀원 이름을 훑지 못하게 하기 위해서다.
model RejoinAttempt {
  key   String   @id
  count Int      @default(1)
  /// 이 시각이 지나면 횟수를 처음부터 다시 센다(= 잠금이 풀린다).
  until DateTime
}

/// 팀에 **처음** 들어오려는 요청. 팀장이 승인해야 팀원이 된다.
///
/// 초대 코드를 아는 것만으로 들어오면, 코드가 한 번 새면 누구든 팀 안을 볼 수 있다.
/// 팀장이 직접 초대했든 본인이 요청했든 마지막 문은 팀장이 연다.
///
/// 아직 `Member` 가 아니라서 온보딩에서 고른 값(MBTI·희망 역할)을 여기 들고 있다가,
/// 승인되는 순간 `Member` 로 옮긴다.
model JoinRequest {
  id           String    @id @default(cuid())
  teamId       String
  /// 이 초대를 타고 온 요청. null 은 마이그레이션 전에 생겼거나 `Team.code` 로 온 요청이다.
  ///
  /// **초대를 지워도 요청은 남는다(`onDelete: SetNull`).** 여기서 지워 버리면, 초대 한 장을
  /// 가진 사람이 팀장 목록의 기록을 지울 수 있다 — 거절과 승인이 남는 것이 감사 근거다.
  inviteId     String?
  name         String
  email        String?
  mbti         String?
  mbtiFromQuiz Boolean   @default(false)
  wantRole     String?
  vetoRole     String?
  /// 승인되면 이 토큰으로 세션이 만들어진다. 요청한 브라우저만 갖고 있다.
  token        String    @unique
  /// pending | approved | rejected
  status       String    @default("pending")
  label        String?
  createdAt    DateTime  @default(now())
  resolvedAt   DateTime?
  approvedById String?

  team       Team        @relation(fields: [teamId], references: [id], onDelete: Cascade)
  invite     TeamInvite? @relation(fields: [inviteId], references: [id], onDelete: SetNull)
  approvedBy Member? @relation("JoinApprover", fields: [approvedById], references: [id], onDelete: SetNull)

  /// 같은 이름으로 요청이 쌓이지 않게 한다.
  @@unique([teamId, name])
  @@index([teamId])
}

/// 이메일 OTP 및 매직 링크 인증 토큰.
///
/// 6자리 번호는 해시로 저장하며, 유효 시간은 10분입니다.
/// 시도 횟수(attempts)가 5회 초과 시 무효 처리됩니다.
model EmailAuthToken {
  id        String   @id @default(cuid())
  email     String
  codeHash  String
  token     String   @unique
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
}

/// 앱 안 알림.
///
/// 팀플에서 놓치는 일은 대부분 "나한테 온 줄 몰랐다"에서 온다. 콕 찌르기·회의 제안·
/// 정정 요청은 전부 "알린다"고 적혀 있지만, 앱을 열어 그 화면까지 가야만 보였다.
///
/// **보낸 사람을 남긴다.** 누가 요청했는지 알아야 답할 수 있다.
model Notification {
  id        String    @id @default(cuid())
  /// 받는 사람.
  memberId  String
  /// poke | meeting | schedule-ask | contrib-dispute | contrib-confirm | join-request | rejoin-request | icebreak | who-does-it | drive
  kind      String
  title     String
  body      String
  /// 누르면 갈 곳. 없으면 알림만 보여 준다.
  href      String?
  /// 보낸 사람. 시스템이 보낸 것이면 null.
  actorId   String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  member Member  @relation("NotifyTo", fields: [memberId], references: [id], onDelete: Cascade)
  actor  Member? @relation("NotifyBy", fields: [actorId], references: [id], onDelete: SetNull)

  @@index([memberId, readAt])
}

/// 이 단말의 푸시 구독.
///
/// 앱 안 알림함과 **같은 알림을** 밖에서도 받는 통로다. 앱을 닫아 둔 사이 오는 일은
/// 여기로만 닿는다 — 그래서 이 앱에서 가장 조심해야 할 저장소다.
///
/// **`endpoint` 가 구독의 신분이다.** 브라우저가 만들어 주는 주소(푸시 서비스의 URL)라
/// 유일하게 두고, 같은 단말이 다시 구독하면 새 행을 쌓지 않고 그 주인을 바꾼다 — 한 사람이
/// 기기를 넘겨 쓰면 그 뒤로 알림은 새 사람에게 가야 한다.
model PushSubscription {
  id        String   @id @default(cuid())
  /// 이 구독으로 알림을 받는 사람.
  memberId  String
  /// 푸시 서비스가 준 단말 주소. 그대로 발신할 때 쓴다.
  endpoint  String   @unique
  /// 발신 암호화 키(사용자 공개키 p256dh).
  p256dh    String
  /// 발신 인증값(auth).
  auth      String
  createdAt DateTime @default(now())

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId])
}

/// 안 되는 시간 한 칸. 표시하지 않은 시간은 가능한 시간으로 본다.
model BusyBlock {
  id        String @id @default(cuid())
  memberId  String
  /// 0 = 월요일.
  day       Int
  /// `SCHEDULE_HOURS` 의 인덱스.
  startHour Int
  hours     Int
  /// class | work | exam | custom — 사유는 본인에게만 보인다.
  kind      String
  /// `custom` 일 때 본인이 적은 이름("동아리"). 팀원에게는 어디서도 보이지 않는다.
  label     String?
  /// null = 매주. 값이 있으면 그 주에만 — 그 주 월요일의 한국 날짜("2026-09-28").
  /// 시각이 아니라 날짜 문자열이라 서버·화면의 시간대와 상관없이 같은 주를 가리킨다.
  weekOf    String?

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId])
}

/// 회의 시간 후보.
///
/// 팀원들의 `BusyBlock` 에서 계산한다(`server/meetings/candidates.ts`) — 오늘부터 7일,
/// 주말 포함, 1시간 단위. 7일이라 요일(`day`)이 어느 날인지 하나로 정해진다.
model MeetingSlot {
  id         String @id @default(cuid())
  teamId     String
  /// "수" 같은 요일 한 글자.
  day        String
  /// "16:00 – 18:00"
  time       String
  available  Int
  total      Int
  /// 못 오는 사람과 사유. 전원 가능하면 null.
  blockedBy  String?
  /// 어느 주의 후보인지. "this" = 이번 주, "none" = 전원 불가한 주(데모).
  weekKey    String @default("this")

  team      Team              @relation(fields: [teamId], references: [id], onDelete: Cascade)
  proposals MeetingProposal[]

  @@index([teamId, weekKey])
}

/// 회의 제안. **특정 한 사람이 단독으로 확정하지 않는다** — 마감까지 반대가 없어야 확정된다.
model MeetingProposal {
  id           String   @id @default(cuid())
  teamId       String
  slotId       String?
  proposedById String
  /// proposed | confirmed | carried — idle 은 행이 없는 상태다.
  stage        String   @default("proposed")
  /// 팀마다 **진행 중인 결정은 하나**다. `proposed`·`confirmed` 동안 `teamId` 를 담고,
  /// 이월(`carried`)처럼 보류인 동안은 비어 있다. 유일 인덱스가 "확정된 회의를 조용히
  /// 덮어쓰는 제안"을 DB 에서 막는다 — 두 사람이 우연히 동시에 눌러도 하나만 선다.
  activeKey    String?  @unique
  /// 이 회의가 **어느 날**인지. "2026-09-30" (`week.ts` 의 날짜 문자열과 같은 형태).
  ///
  /// 후보 행(`MeetingSlot`)은 요일("수")로만 남는다 — 어느 수요일인지 알 수 없다.
  /// 그래서 확정이 한 달을 넘겨 살아 있으면 화면 어디에도 날짜가 없고, 시간표 격자에도
  /// 그릴 칸을 찾지 못한다(후보 기간인 7일을 지나면 요일이 창 밖으로 나간다).
  /// 제안할 때의 날짜를 여기에 고정해 두면 확정된 회의가 "9/30(수) 16:00" 이라는
  /// 사실로 남는다. 예전 행은 null 이라 화면이 후보 기간 안의 요일로 되짚어 보여 준다.
  date         String?
  /// 응답 마감 시각. 이때까지 반대가 없으면 확정.
  respondBy    DateTime
  createdAt    DateTime @default(now())

  team       Team              @relation(fields: [teamId], references: [id], onDelete: Cascade)
  slot       MeetingSlot?      @relation(fields: [slotId], references: [id], onDelete: SetNull)
  proposedBy Member            @relation(fields: [proposedById], references: [id], onDelete: Cascade)
  responses  MeetingResponse[]

  @@index([teamId])
}

model MeetingResponse {
  id         String   @id @default(cuid())
  proposalId String
  memberId   String
  /// true = 동의, false = 참석 어려움.
  agree      Boolean
  createdAt  DateTime @default(now())

  proposal MeetingProposal @relation(fields: [proposalId], references: [id], onDelete: Cascade)
  member   Member          @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([proposalId, memberId])
}

/// 역할 추첨 결과. 당사자가 수락해야 확정된다.
model RoleDraw {
  id        String   @id @default(cuid())
  teamId    String
  /// research | deck | script | present | manage
  role      String
  /// 어떤 도구로 뽑았는지 — "룰렛" 처럼 화면에 그대로 보인다.
  tool      String
  winnerId  String
  accepted  Boolean  @default(false)
  createdAt DateTime @default(now())

  winner Member @relation(fields: [winnerId], references: [id], onDelete: Cascade)

  @@unique([teamId, role])
}

/// 추첨을 거절해 다음 추첨에서 빠지는 사람.
model RoleRejection {
  id       String @id @default(cuid())
  teamId   String
  role     String
  memberId String

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([teamId, role, memberId])
}

/// 역할별 제출함. 마감이 지나도 잠그지 않고 라벨만 붙인다.
model SubmissionBox {
  id       String @id @default(cuid())
  teamId   String
  role     String
  name     String
  /// 이 칸을 맡은 사람. **역할이 정해지기 전에는 비어 있다** — 팀을 만들면 제출함부터
  /// 생기고, 역할 추첨을 수락하면 그 사람이 주인이 된다.
  ownerId  String?
  /// 마감 시각. **"마감 후 제출" 라벨은 이 값과 버전의 `createdAt` 으로 그때그때 계산한다** —
  /// 마감을 옮기면 라벨도 따라 바뀐다. 정하지 않았으면 null 이고 라벨이 붙지 않는다.
  dueAt    DateTime?
  /// 예전 표시 문자열("9/15", "미정"). `dueAt` 이 없을 때만 화면에 보인다.
  due      String

  team  Team            @relation(fields: [teamId], references: [id], onDelete: Cascade)
  owner Member?         @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  files SubmittedFile[]

  @@index([teamId])
}

/// 제출함에 올라온 파일 하나.
///
/// 제출함과 버전 사이에 이 단계가 필요하다 — 한 제출함에 파일이 여러 개일 수 있고
/// (발표자료.pptx 와 대본.docx), 버전은 **그 파일 하나**의 역사이기 때문이다.
model SubmittedFile {
  id        String   @id @default(cuid())
  boxId     String
  /// 화면에 보이는 파일 이름("발표 자료.pptx").
  name      String
  /// pptx | docx | pdf | image
  kind      String
  createdAt DateTime @default(now())

  box      SubmissionBox @relation(fields: [boxId], references: [id], onDelete: Cascade)
  versions FileVersion[]

  @@index([boxId])
}

/// 파일 버전. **덮어쓰지 않고 쌓인다** — 복원도 새 버전을 더하는 것이다.
model FileVersion {
  id         String   @id @default(cuid())
  fileId     String
  /// "v4" 처럼 화면에 그대로 보이는 이름.
  label      String
  authorId   String
  note       String
  size       String
  /// pptx | docx | pdf | image
  kind       String
  /// 실제로 열리는 형식만 미리보기 주소를 갖는다. 저장소에 올린 파일은 볼 때마다
  /// 서명된 주소를 새로 만들므로 여기에는 남기지 않는다(시드 이미지에만 남아 있다).
  previewUrl String?
  /// Supabase Storage 안의 경로. 저장소에 없는 시드 데이터는 null 이다.
  storagePath String?
  /// 실제 바이트 수. `size` 는 화면에 보이는 문자열이라 계산에 쓰면 안 된다.
  bytes      Int?
  /// 내려받을 때 브라우저에 알려 줄 형식.
  mimeType   String?
  /// 쓰지 않는다 — 올릴 때 한 번 적어 두면 마감을 옮겨도 라벨이 안 바뀌었다.
  /// 이제 `SubmissionBox.dueAt` 과 `createdAt` 으로 계산한다. 다음 정리 때 지운다.
  isLate     Boolean  @default(false)
  createdAt  DateTime @default(now())
  /// 쓰지 않는다 — 저장된 "방금"이 영원히 "방금"으로 보였다. 화면 시각은 `createdAt` 으로
  /// 서버가 만든다. 다음 정리 때 지운다.
  whenLabel  String?
  /// 복원으로 생긴 버전이면 원본 버전 id. 복원은 마감과 무관한 작업이라 늦은 제출로 세지
  /// 않고, 같은 저장소 객체를 가리키므로 용량에도 두 번 세지 않는다.
  restoredFromId String?

  file   SubmittedFile @relation(fields: [fileId], references: [id], onDelete: Cascade)
  author Member        @relation(fields: [authorId], references: [id], onDelete: Cascade)

  /// 드라이브에서 단톡방에 공유된 말들이 가리킨다. 공유는 **바이트를 복사하지 않는다** —
  /// 이 버전을 가리킬 뿐이라 용량에도 두 번 세지 않는다.
  sharedInMessages Message[] @relation("MessageSharesVersion")
  /// 채팅 첨부를 드라이브에 올려 생긴 버전. 한 첨부에 하나만 둔다.
  savedFromMessages Message[] @relation("MessageSavedAsVersion")

  @@index([fileId])
}

/// 메시지. 팀 단톡방과 1:1 DM 이 같은 표에 들어가고 `threadKey` 로 갈린다.
model Message {
  id         String   @id @default(cuid())
  teamId     String
  /// "team" 또는 DM 상대 두 명의 id 를 정렬해 이은 값("dm:<a>:<b>").
  threadKey  String
  authorId   String
  text       String
  /// 쿠션 번역기로 다듬어 보낸 말. **표시가 남는다.**
  viaCushion Boolean  @default(false)
  /// 화면이 보내기 전에 만들어 둔 id. **같은 값으로 두 번 도착하면 한 번만 저장한다.**
  ///
  /// 서버가 저장했는데 응답이 늦어 화면이 "실패"로 바꾸고 사용자가 다시 누르면, 그 말은
  /// 이미 들어 있다 — 예전에는 그 결과 같은 말이 두 개 생겼다. 첨부는 `attachPath` 로 막고
  /// 있었지만 글에는 그런 표가 없었으므로, 이 값으로 막는다. 두 번 저장되면 대화의 사실이
  /// 틀어지는 것이라 되돌리기 어렵다.
  clientId String?
  /// 첨부 파일(단톡방만). 저장소 경로는 `{teamId}/chat/{uuid}` — 드라이브와 같은 버킷·형식·용량 규칙.
  /// 파일만 보낸 말은 `text` 가 빈 문자열이다.
  attachPath  String?
  attachName  String?
  attachBytes Int?
  attachMime  String?
  /// 드라이브 파일을 단톡방에 공유한 말. **저장소 객체를 복사하지 않고 그 버전만 가리킨다.**
  /// 공유는 단톡방에서만( DM 은 첨부와 마찬가지다).
  driveVersionId String?
  /// 이 첨부를 드라이브에 올려서 생긴 버전. 한 첨부에 하나만 — 두 번 올리면 같은 바이트가
  /// 용량에 두 번 세어진다. 이미 있으면 화면은 "드라이브에 있음"을 보여 주고 다시 만들지 않는다.
  savedVersionId  String?
  createdAt  DateTime @default(now())
  /// 화면에 보이는 시각 문자열("14:02").
  whenLabel  String

  team      Team              @relation(fields: [teamId], references: [id], onDelete: Cascade)
  author    Member            @relation(fields: [authorId], references: [id], onDelete: Cascade)
  /// 드라이브 파일·버전이 지워지면 공유/저장 자리만 비운다 — **말 자체는 남는다.**
  /// 드라이브 기록은 팀의 공식 기록이라 임의로 지우지 않지만, 말은 남기는 편이 낫다.
  driveVersion FileVersion?     @relation("MessageSharesVersion", fields: [driveVersionId], references: [id], onDelete: SetNull)
  savedVersion  FileVersion?     @relation("MessageSavedAsVersion", fields: [savedVersionId], references: [id], onDelete: SetNull)
  reactions MessageReaction[]
  /// 이 말을 읽기 설정별로 순화해 둔 결과(19·31 화면의 읽기 순화). **사람이 아니라
  /// 설정(강도·말투·프롬프트·모델)마다 한 줄**이라 팀원 수만큼 중복 계산되지 않는다.
  purifications MessagePurification[]

  @@unique([authorId, clientId])
  /// DM 목록은 "이 대화의 마지막 말 한 개" 를 4초마다 다시 읽는다. 그 정렬이
  /// `(teamId, threadKey, createdAt DESC)` 이지 않으면 Postgres 가 **해당 대화의 전체
  /// 메시지**를 읽고 자른다 — DM 이 쌓일수록 폴링 한 번의 비용이 그대로 오른다.
  ///
  /// 여기도 예전에 `@@index([teamId, threadKey])` 가 따로 있었다. b-tree 는 왼쪽부터 쌓이므로
  /// 아래 인덱스가 곧 접두사라 짧은 쪽은 **읽히지 않았다.** 50,040행으로 직접 비교했을 때
  /// 대표 여섯 질문의 계획과 읽은 행이 제거 전후에 완전히 같았다. 메시지가 늘어날 때마다
  /// 쓰기만 늘던 인덱스였다.
  @@index([teamId, threadKey, createdAt])
}

model MessageReaction {
  id        String @id @default(cuid())
  messageId String
  memberId  String
  icon      String

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  member  Member  @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([messageId, memberId, icon])
}

/// 어디까지 읽었는지. 안 읽음 배지가 이 값으로 계산된다.
model ReadMark {
  id        String   @id @default(cuid())
  memberId  String
  threadKey String
  readAt    DateTime @default(now())

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([memberId, threadKey])
}

/// 이 말을 **어떤 읽기 설정으로** 순화해 둔 결과.
model MessagePurification {
  id        String   @id @default(cuid())
  messageId String
  /// 이 결과를 만든 설정의 지문. 같은 말 + 같은 설정 = 같은 결과다.
  ///
  /// **사람을 열쇠에 넣지 않는다** — 이것이 이 구조의 전부다. 예전에는 (말, 읽는 사람)마다
  /// 한 줄이 있어서 팀원 5명이면 **같은 말을 5번** 모델에 불렀다(AI 한도 1회씩). 팀플은
  /// 4~5명이 방에서 같이 읽는데, 그만큼 같은 대화가 중복 계산되었다.
  ///
  /// 지문에는 **결과를 바꾸는 것만** 넣는다: 읽기 강도·말투·프롬프트 버전·모델·검사 버전.
  /// 읽는 사람이 바뀐다고 결과가 바뀌지는 않는다.
  policyHash String
  /// 이 결과를 만든 조건 — 지문이 왜 그런 값인지 남긴다(재생성 판단용).
  level    String
  tone     String
  model    String
  promptVersion    String
  validatorVersion String
  /// 원문 지문. 원문은 안 바뀌지만, "같은 입력으로 만든 것인가" 를 판정하는 기준이다.
  sourceHash String
  /// 화면에 그릴 문장. 실패 상태면 `null` 이고 그때는 **원문이 보인다**.
  text   String?
  /// 이 문장을 누가 썼나: `ai`(모델) / `mask`(규칙). **표시가 다르므로 반드시 남긴다.**
  source String?
  /// PENDING | PURIFIED | FALLBACK | REJECTED | FAILED
  status String   @default("PENDING")
  /// 실패 taxonomy(실패할 때만). 지표와 재생성 판단에 쓴다 — 화면에는 안 보여 준다.
  reason  String?
  /// 실제로 모델을 부른 횟수. 무한 재호출의 근거이자, 몇 번을 더 시도할지 정하는 값.
  attemptCount Int    @default(0)
  /// 이 묶음의 **호출 시간**(ms). 묶음의 모든 행이 같은 값을 갖는다 — 그래서 "행 기준 평균"은
  /// 큰 묶음에 끌려간다. 호출 수와 함께 볼 때만 뜻가 있다.
  latencyMs Int?
  /// 이 시각 전에는 다시 부르지 않는다. 재생성 가능해지면 서버가 지금으로 옮긴다.
  retryAfter DateTime?
  /// `PENDING` 선점 토큰. **이 값이 내 것인 요청만 모델을 부른다** — 두 사람·두 탭이 같은
  /// 설정으로 같은 말을 동시에 시켜도 한 번만 부른다.
  claimToken String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  message Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@unique([messageId, policyHash])
  /// 실패 캐시 조회: "이 말이 이 설정으로 이미 어떻게 됐나" 를 id 목록으로 한 번에 본다.
  @@index([messageId])
}

/// 실패 캐시는 **읽는 사람 사이에 공유된다.** 한 사람이 거절당하면 그 결과(상태·사유·
/// 시도 횟수·재시도 시각)는 그 말을 같은 설정으로 읽을 사람에게 그대로 전달된다 —
///
/// 5명이 각자 한 번씩 거절을 시도할 이유가 없다. `ReadCushion` 이 읽는 조건을 정하고,
/// 여기에는 **조건별 결과**만 있다.
///
/// 사람별로 "이 화면에서 무엇을 보여 줄지" 를 따로 고르는 기능이 생기면 그때 두 번째 표가
/// 돌아온다(말 → 순화본, 사람 → 화면 선택). 지금은 그 선택이 없으므로 **표가 하나여야
/// 중복 계산이 없다.**

/// 한 사람이 이 방의 말을 **어떤 말투로 읽는지**. 읽기 전용이라 저장된 원문은 그대로다.
///
/// **끄는 칸이 없다** — 순화는 이 앱의 약속이고(받는 사람은 순화된 표현을 받는다),
/// 꺼진 화면을 보면 그 말이 순화본인지 원문인지 알 수 없다. 원문을 보고 싶을 때는
/// 말풍선을 누른다.
///
/// 대화방마다 한 줄이다 — "단톡방은 부드럽게, DM 은 담담하게"가 가능해야 하므로
/// 사람당 하나의 값만 두면 안 된다.
model ReadCushion {
  id        String   @id @default(cuid())
  memberId  String
  threadKey String
  /// 읽기 순화를 **끄는지**. 끄면 AI 호출 후보를 **아예 만들지 않는다** — 원문으로만 읽는다.
  ///
  /// 강도(`mode`)와 따로 둔다. 둘을 한 칸(`mode: "OFF"`)으로 합치면 **끄기 전에 고른
  /// 단계를 잃는다** — 다시 켰을 때 몇 단계였는지 몰라 다시 골라야 한다.
  enabled   Boolean  @default(true)
  /// 읽기 강도: `LIGHT`(욕설만) · `NORMAL`(공격성까지) · `STRONG`(책임 추궁·비꼼까지).
  mode      String   @default("NORMAL")
  /// 말투("soft" | "plain" | "firm"). 처음엔 15 쿠션 번역기와 같은 첫 값으로 읽는다.
  tone      String   @default("soft")
  updatedAt DateTime @updatedAt

  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@unique([memberId, threadKey])
}


/// 기여 기록.
///
/// 내 화면(16)과 팀 화면(17)이 **같은 표**를 본다 — 두 표로 나누면 같은 일이 두 곳에서
/// 다르게 적히는 일이 생긴다.
model ContribRecord {
  id        String   @id @default(cuid())
  memberId  String
  /// task | file | meet | help | due
  kind      String
  title     String
  detail    String
  /// 사람이 적은 설명("9/8 – 9/12"). 없는 기록이 많다 — 언제 추가했는지는 `createdAt` 이
  /// 말하고 화면이 그때 그때 만든다("방금", "3주 전"). 시각을 여기 저장하면 저장한
  /// 순간의 말로 굳어 버린다(`lib/when.ts` 가 같은 이유로 파일 쪽은 `createdAt` 을 쓴다).
  whenLabel String?
  /// auto = 앱이 모음 / self = 본인이 직접 추가
  source    String
  /// ok | pending | disputed — 확인 수와 의견에서 다시 계산한다(`server/contrib/state.ts`).
  state     String   @default("pending")
  /// 사실과 다르다고 적힌 의견. **한쪽 말로 덮지 않고 남긴다.**
  ///
  /// 여기 값이 있어도 지우지 않는다. 새로 의견이 달리면 아래 `ContribDispute` 에
  /// **추가**하고 이 칸은 "지금 떡고 있는 의견"으로 옮긴다. 예전에는 `update` 가 이 칸을
  /// 그냥 덮어써서, 정리된 뒤 새로 달린 의견이 앞선 의견과 합의 내용까지 함께 지웠다 —
  /// 17 화면이 약속한 "한쪽 말로 덮지 않고 둘 다 남깁니다" 와 정면으로 어긋났다.
  dispute   String?
  /// 그 의견을 적은 사람. 다툼이 생기면 누가 적었는지가 중요하다.
  disputedById String?
  /// 정정에 어떻게 답했는지("공동 작업으로 나눔"). 적히면 의견 차이가 정리된 것으로 본다.
  /// `dispute` 는 여기 값이 생겨도 지우지 않는다 — 지우면 한쪽 말로 덮는 것이 된다.
  resolution String?
  /// 근거 파일. 본인이 직접 추가한 기록에만 붙는다 — 팀원이 확인할 때 열어 본다.
  /// 저장소 경로는 `{teamId}/evidence/{uuid}` 이고 드라이브와 같은 버킷·형식·용량 규칙을 따른다.
  evidencePath  String?
  evidenceName  String?
  evidenceBytes Int?
  evidenceMime  String?
  createdAt DateTime @default(now())

  member     Member          @relation("ContribOwner", fields: [memberId], references: [id], onDelete: Cascade)
  disputedBy Member?         @relation("ContribDisputer", fields: [disputedById], references: [id], onDelete: SetNull)
  confirms   ContribConfirm[]
  /// 의견의 이력. **덮어쓰지 않는다.**
  disputes   ContribDispute[]
  participations ContribParticipation[]

  @@index([memberId])
}

/// 한 사람이 한 기록에 남긴 의견 하나.
///
/// 정리는 되돌릴 수 없으니 의견 자체는 남겨 둔다. `ContribRecord.dispute` 는 지금
/// 떠 있는 의견 하나만 가리키지만 이 표가 전부다 — 정리된 뒤 다시 의견이 달리면 앞선
/// 의견은 여기에 그대로 있고, 화면은 시간순으로 모두 보여 준다.
model ContribDispute {
  id        String   @id @default(cuid())
  recordId  String
  byId      String
  text      String
  createdAt DateTime @default(now())

  record ContribRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)
  by     Member        @relation("ContribDisputesBy", fields: [byId], references: [id], onDelete: Cascade)

  @@index([recordId, createdAt])
}

/// 기여 기록 하나에 대한 팀원의 확인.
///
/// 본인이 넣은 기록은 팀원이 확인해야 확정된다 — 본인 말만으로 확정되면 기록이
/// 근거가 되지 못한다. 누가 확인했는지 남아야 나중에 다툴 때 따져 볼 수 있다.
model ContribConfirm {
  id        String   @id @default(cuid())
  recordId  String
  memberId  String
  createdAt DateTime @default(now())

  record ContribRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)
  member Member        @relation(fields: [memberId], references: [id], onDelete: Cascade)

  /// 같은 사람이 같은 기록을 두 번 확인하지 못한다.
  @@unique([recordId, memberId])
  @@index([recordId])
}

/// 회의 참여 표시 — **팀장이 직접 찍는다.** 앱이 판정하지 않는다.
///
/// 정책이 정해졌다(README 3절): 입장과 발언을 앱이 정확히 아는 쪽이 아니라 자동 판정이
/// 정직하지 않으면, 팀장이 표시한다. 그 표시가 **어디에 붙는지**가 이 표의 모양이다.
///
/// - **기록 하나**에 붙는다. 참여자는 따로 적지 않는다 — `record.memberId` 가 곧 참여자라
///   두 곳에 적으면 서로 어긋난다. 공동 작업은 23 화면의 정정 응답("공동 작업으로 나눔")이
///   그 자리를 이미 맡고 있다.
/// - **지우지 않는다.** 표시를 취소해도 행은 남고 누가 · 언제 취소했는지 적힌다. 공로 평가가
///   아니라 사실 기록이라 조작이 드러나야 나중에 따져 볼 수 있다.
/// - **확인과 독립이다.** 참여한다고 기록이 확정되지 않는다(확인은 팀원이 한다).
model ContribParticipation {
  id        String   @id @default(cuid())
  recordId  String
  /// 현재 표시 중이면 그 기록의 id, 취소했으면 null.
  ///
  /// 유일 인덱스가 "한 기록에 표시가 두 개"를 **DB 에서** 막는다 — 두 사람이 우연히 동시에
  /// 눌러도 하나만 선다. `MeetingProposal.activeKey` · `IceRound.activeKey` 와 같은 방식이고,
  /// 지운 자리에 다시 찍을 수 있다는 이유로 과거 행까지 막지 않는다.
  activeKey String?  @unique
  /// 표시한 팀장. "누가 찍었나"를 남긴다.
  shownById String
  shownAt   DateTime @default(now())
  /// 취소한 팀장과 시각. 지금 표시 중이면 null.
  clearedById String?
  clearedAt   DateTime?

  record    ContribRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)
  shownBy   Member        @relation("ParticipationShownBy", fields: [shownById], references: [id], onDelete: Cascade)
  clearedBy Member?       @relation("ParticipationClearedBy", fields: [clearedById], references: [id], onDelete: SetNull)

  @@index([recordId, shownAt])
}

/// 할 일. 팀 업무·개인 학습·점검이 한 목록에 있고 종류로만 구분된다.
model Task {
  id         String   @id @default(cuid())
  teamId     String
  title      String
  /// team | study | check
  kind       String
  /// 담당자. 정해지지 않았으면 null — 비워 두는 것이 임의 배정보다 낫다.
  assigneeId String?
  /// "9/19" 같은 표시 문자열.
  due        String
  /// todo | doing | done
  status     String   @default("todo")
  /// clerk = AI 서기가 만듦 / manual = 사람이 직접 넣음
  source     String   @default("manual")
  /// 누가 넣었나. **담당자 지정 권한의 근거** — `server/actions/tasks.ts` 의 `canEditTask`.
  /// 기존 행은 `null` 이고, 그 할 일은 팀장만 고칠 수 있다(주인이 누구인지 되돌릴 수 없으므로).
  createdById String?
  createdAt  DateTime @default(now())

  team      Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  assignee  Member?  @relation(fields: [assigneeId], references: [id], onDelete: SetNull)
  createdBy Member?  @relation("TaskCreator", fields: [createdById], references: [id], onDelete: SetNull)
  pokes     Poke[]

  @@index([teamId])
  @@index([createdById])
}

/// 콕 찌르기 — 담당자에게 **제출이나 진행상황을 요청**한다.
///
/// 보낸 사람을 밝힌다. 누가 물었는지 알아야 답할 수 있고, 익명 재촉은
/// 답할 곳 없는 압박이 된다. 대신 **업무당 하루 한 번**으로 횟수를 막는다.
model Poke {
  id       String   @id @default(cuid())
  taskId   String
  senderId String
  sentOn   String
  createdAt DateTime @default(now())

  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  sender Member @relation(fields: [senderId], references: [id], onDelete: Cascade)

  /// 같은 사람이 같은 업무를 같은 날 두 번 찌를 수 없다.
  @@unique([taskId, senderId, sentOn])
}

/// AI 도구를 한 번 쓴 기록.
///
/// **입력한 글도 결과도 남기지 않는다** — 남는 것은 "누가 언제 어떤 도구를 썼는지"뿐이다.
/// 호출마다 비용이 들어서 하루 한도를 세려면 어딘가에 세어 둘 곳이 필요하고,
/// 그 한도를 넘는 순간 화면이 그 사실을 그대로 알려 줘야 하기 때문이다.
///
/// 보관 기간은 `AI_POLICY.retentionDays` 다. 지난 행은 예약 작업이 지운다.
model AiUsage {
  id       String @id @default(cuid())
  teamId   String
  memberId String
  /// cushion | clerk | research | present | sentence
  tool     String
  /// 한국 날짜(YYYY-MM-DD). 콕 찌르기의 "하루"와 같은 기준이다 — 서버가 어디서 돌든
  /// 같은 하루여야 한다.
  day      String
  createdAt DateTime @default(now())

  team   Team   @relation(fields: [teamId], references: [id], onDelete: Cascade)
  member Member @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([teamId, day])
  @@index([memberId, day])
}

/// 28 아이스브레이킹의 한 판 — 라이어 게임·마피아.
///
/// 비밀(제시어·역할)은 **서버가 나누고 서버에만 있다.** 화면에는 각자 자기 카드만 내려간다 —
/// 폰에서 나누면 개발자 도구로 남의 카드를 볼 수 있다.
///
/// 팀마다 진행 중인 판은 하나다. `activeKey` 는 진행 중일 때만 `teamId` 를 담고 끝나면
/// 비운다 — 여기에 unique 가 걸려 있어 두 사람이 동시에 "시작"을 눌러도 판이 둘 생기지 않는다.
/// (Postgres 의 unique 는 NULL 을 여럿 허용하므로 끝난 판은 얼마든지 쌓인다.)
model IceRound {
  id        String    @id @default(cuid())
  teamId    String
  activeKey String?   @unique
  /// liar | mafia
  game      String
  /// play = 진행 중(투표 받는 중) / revealed = 결과 공개
  phase     String    @default("play")
  /// 라이어 게임의 주제와 제시어. 제시어는 결과 공개 전에는 라이어가 아닌 사람에게만 보인다.
  topic     String?
  word      String?
  /// 마피아의 결과 문구("시민 승리"). 끝나기 전에는 null.
  outcome   String?
  /// 판을 연 사람 = 사회자. 결과 공개·투표 마감·끝내기를 할 수 있다(팀장도 할 수 있다).
  hostId    String
  createdAt DateTime  @default(now())
  endedAt   DateTime?

  team  Team      @relation(fields: [teamId], references: [id], onDelete: Cascade)
  host  Member    @relation("IceHost", fields: [hostId], references: [id], onDelete: Cascade)
  seats IceSeat[]

  @@index([teamId, createdAt])
}

/// 한 판의 자리. 시작할 때 있던 팀원만 앉는다 — 중간에 들어온 사람은 구경만 한다.
model IceSeat {
  roundId   String
  memberId  String
  /// 라이어: liar | citizen / 마피아: mafia | police | doctor | citizen
  role      String
  /// 마피아에서 탈락한 시각과 방법(vote = 낮 투표 / night = 사회자가 밤 결과로 표시).
  /// 라이어 게임은 늘 null. 탈락 순서는 `outAt` 으로 정한다.
  outAt     DateTime?
  outHow    String?
  /// 지금 투표에서 고른 사람. 투표를 마감하면 비운다.
  voteForId String?

  round  IceRound @relation(fields: [roundId], references: [id], onDelete: Cascade)
  member Member   @relation("IceSeatOf", fields: [memberId], references: [id], onDelete: Cascade)

  @@id([roundId, memberId])
}
